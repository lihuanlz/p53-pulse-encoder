\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The channel census of the excitable encoder. \textbf  {a}, Reference pulse train of the FitzHugh--Nagumo representative under Eq.~\eqref  {eq:fhn}. \textbf  {b}, Fisher spectrum across three numerical configurations; the seventh direction is at the resolution floor ($\lambda _7/\lambda _1\le 4.7\times 10^{-19}$). \textbf  {c}, Eigenvector composition; the softest direction is the noise amplitude $\sigma $ (weight $0.996$). \textbf  {d}, Channel shares of parameter information: timing-type channels $94.5\%$, amplitude $5.5\%$ (representative calibration; ordering robust, exact shares calibration-bounded). \textbf  {e}, First-pulse dispersion ratio $\mathrm  {Var}(t_1)/\mathrm  {Var}(T)$ under one upstream exponential sensing delay (literature-matched calibration): bare oscillators sit at $0.03$--$0.12$ (shaded band); the measured $5.8$ (dashed) is reached at $\mu _d\approx T$ (open marker: quadratic extrapolation of the calibrated segment, registered in the Discussion). \textbf  {f}, The counting law $N\approx 10.5\ln I_0+c$ with $I(D;N)=3.07/3.17$ bits; inset, the gain-dispersion kill: population $\mathrm  {CV}(A)$ rises with gain dispersion while $\mathrm  {CV}(T)$ stays pinned.}}{7}{figure.caption.3}\protected@file@percent }
\newlabel{fig:census}{{2}{7}{The channel census of the excitable encoder. \textbf {a}, Reference pulse train of the FitzHugh--Nagumo representative under Eq.~\eqref {eq:fhn}. \textbf {b}, Fisher spectrum across three numerical configurations; the seventh direction is at the resolution floor ($\lambda _7/\lambda _1\le 4.7\times 10^{-19}$). \textbf {c}, Eigenvector composition; the softest direction is the noise amplitude $\sigma $ (weight $0.996$). \textbf {d}, Channel shares of parameter information: timing-type channels $94.5\%$, amplitude $5.5\%$ (representative calibration; ordering robust, exact shares calibration-bounded). \textbf {e}, First-pulse dispersion ratio $\mathrm {Var}(t_1)/\mathrm {Var}(T)$ under one upstream exponential sensing delay (literature-matched calibration): bare oscillators sit at $0.03$--$0.12$ (shaded band); the measured $5.8$ (dashed) is reached at $\mu _d\approx T$ (open marker: quadratic extrapolation of the calibrated segment, registered in the Discussion). \textbf {f}, The counting law $N\approx 10.5\ln I_0+c$ with $I(D;N)=3.07/3.17$ bits; inset, the gain-dispersion kill: population $\mathrm {CV}(A)$ rises with gain dispersion while $\mathrm {CV}(T)$ stays pinned}{figure.caption.3}{}}
