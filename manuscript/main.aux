\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Topology selection, numerics and evidence. \textbf  {a}, NF discriminator: squared amplitude linear in drive above the Hopf point ($R^2=0.9926$; delayed variant $0.971$). \textbf  {b}, Amplitude grading separates the classes: EXC holds $+6.5\%$ over a 4.6-fold drive ($\alpha =0.014$), NF gains $+360\%$, and the Morris--Lecar leaky-digital control sits an order of magnitude below NF ($\alpha =-0.258$). \textbf  {c}, The subcritical escape hatch and how the remaining signatures close it (measured hysteresis $0.275$ versus normal-form $0.25$). \textbf  {d}, The counting law above the damage threshold ($R^2=0.920$; slope inverts the period). \textbf  {e}, The built-in two-arm control: digitised p53 pulse amplitudes after NCS (double-strand breaks, dose-invariant, 1.40$\times $ spread, non-monotone) and after UV (graded, 4.3$\times $ monotone), with the bootstrap separation annotated. \textbf  {f}, The discrimination grid: measured $(\alpha ,\nu )$ pairs for the two damage arms and the two model anchors, with the counting and amplitude regimes separated by an order of magnitude in $\alpha $. (Panels are schematic redraws of archived analysis results.)}}{4}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:topology}{{1}{4}{Topology selection, numerics and evidence. \textbf {a}, NF discriminator: squared amplitude linear in drive above the Hopf point ($R^2=0.9926$; delayed variant $0.971$). \textbf {b}, Amplitude grading separates the classes: EXC holds $+6.5\%$ over a 4.6-fold drive ($\alpha =0.014$), NF gains $+360\%$, and the Morris--Lecar leaky-digital control sits an order of magnitude below NF ($\alpha =-0.258$). \textbf {c}, The subcritical escape hatch and how the remaining signatures close it (measured hysteresis $0.275$ versus normal-form $0.25$). \textbf {d}, The counting law above the damage threshold ($R^2=0.920$; slope inverts the period). \textbf {e}, The built-in two-arm control: digitised p53 pulse amplitudes after NCS (double-strand breaks, dose-invariant, 1.40$\times $ spread, non-monotone) and after UV (graded, 4.3$\times $ monotone), with the bootstrap separation annotated. \textbf {f}, The discrimination grid: measured $(\alpha ,\nu )$ pairs for the two damage arms and the two model anchors, with the counting and amplitude regimes separated by an order of magnitude in $\alpha $. (Panels are schematic redraws of archived analysis results.)}{figure.caption.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Measured $(\alpha ,\nu )$ signatures on the discrimination grid. $\alpha $ from digitised dose series (bootstrap $\times 20{,}000$); $\nu $ from the reported pulse-count statistics of \cite  {Monke2017,Lahav2004}.}}{4}{table.caption.2}\protected@file@percent }
\newlabel{tab:grid}{{1}{4}{Measured $(\alpha ,\nu )$ signatures on the discrimination grid. $\alpha $ from digitised dose series (bootstrap $\times 20{,}000$); $\nu $ from the reported pulse-count statistics of \cite {Monke2017,Lahav2004}}{table.caption.2}{}}
