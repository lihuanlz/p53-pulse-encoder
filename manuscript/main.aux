\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Molecular decomposition of the timing constants. \textbf  {a}, Interpulse-interval decomposition ($1.70$ h phase estimate against the measured $2.0\pm 0.5$ h band). \textbf  {b}, First-pulse-delay decomposition ($1.13$ h against the $1.25$ h anchor). \textbf  {c}, Phase-share attribution of the $5.5$ h period across the six molecular species (Jacobian prediction $5.95$ h versus simulation $5.48$ h). \textbf  {d}, Closure status of the Wip1 arm constants, with the stiffest Fisher axis (Wip1 production) marked: one measured constant, one distribution-bounded, two registered gaps.}}{9}{figure.caption.9}\protected@file@percent }
\newlabel{fig:molecular}{{3}{9}{Molecular decomposition of the timing constants. \textbf {a}, Interpulse-interval decomposition ($1.70$ h phase estimate against the measured $2.0\pm 0.5$ h band). \textbf {b}, First-pulse-delay decomposition ($1.13$ h against the $1.25$ h anchor). \textbf {c}, Phase-share attribution of the $5.5$ h period across the six molecular species (Jacobian prediction $5.95$ h versus simulation $5.48$ h). \textbf {d}, Closure status of the Wip1 arm constants, with the stiffest Fisher axis (Wip1 production) marked: one measured constant, one distribution-bounded, two registered gaps}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Independent closed-form cross-validation. \textbf  {a}, Belgacem's closed-form period as a function of loop delay (line), overlaid with our independent Python DDE integration of his equations (points); the measured 5.5 h period and our six-species simulation 5.48 h sit at the dashed line. \textbf  {b}, The same closed form evaluated under four constant sets: Belgacem's own calibration ($5.64$ h) and the stressed-state set (fast p53 turnover, $5.60$ h) land on the measured period, while the basal-state half-lives fail, at $8.40$ h with the measured $2.0$ h delay and at $7.63$ h with the decomposed $1.70$ h delay.}}{9}{figure.caption.10}\protected@file@percent }
\newlabel{fig:closedform}{{4}{9}{Independent closed-form cross-validation. \textbf {a}, Belgacem's closed-form period as a function of loop delay (line), overlaid with our independent Python DDE integration of his equations (points); the measured 5.5 h period and our six-species simulation 5.48 h sit at the dashed line. \textbf {b}, The same closed form evaluated under four constant sets: Belgacem's own calibration ($5.64$ h) and the stressed-state set (fast p53 turnover, $5.60$ h) land on the measured period, while the basal-state half-lives fail, at $8.40$ h with the measured $2.0$ h delay and at $7.63$ h with the decomposed $1.70$ h delay}{figure.caption.10}{}}
